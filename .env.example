# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- SMTP (optional; only needed for the "Retrieve Username" email feature) ---
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# --- PostgreSQL (only needed when running via docker-compose) ---
POSTGRES_DB=pharmastock
POSTGRES_USER=pharma_admin
POSTGRES_PASSWORD=changeme
